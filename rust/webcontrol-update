#!/usr/bin/env bash
# Updates webcontrol-rs on the Pi or an x86_64 Linux laptop from a published GitHub Release, keeping one backup and
# rolling back on failure.
# Run it as the user the service runs as (pi), which asks for the sudo password once, or as root from
# webcontrol-update@.service, which the UI starts. See usage() or --help.
set -euo pipefail

REPO="${WEBCONTROL_REPO:-designfrontier/WebControl}"
API="${WC_GITHUB_API:-https://api.github.com}"
WAIT="${WC_HEALTH_WAIT:-60}"
POLL="${WC_POLL:-1}"
root="${WC_ROOT:-}"
opt="$root/opt/webcontrol-rs"
binary="$opt/webcontrol-rs"
backup="$opt/backup"
unit="$root/etc/systemd/system/webcontrol-rs.service"
dropin="$root/etc/systemd/system/webcontrol.service.d/conflicts.conf"
bindir="$root/usr/local/bin"
sudoers="$root/etc/sudoers.d/webcontrol-rs"
update_unit="$root/etc/systemd/system/webcontrol-update@.service"
states="$root/var/lib/webcontrol-rs"
status_file="$states/update.json"
TAG_RE='^v?[0-9A-Za-z][0-9A-Za-z.+_-]*$'
VERSION_RE='^v?([0-9]+)(\.([0-9]+))?(\.([0-9]+))?(-([0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*))?(\+[0-9A-Za-z.-]+)?$'
release_files=(webcontrol-rs install-pi.sh webcontrol-rs.service webcontrol-conflicts.conf wc-switch webcontrol-rs.sudoers
  webcontrol-update@.service)
AS_ROOT="$([ "$(id -u)" = 0 ] && echo 1 || echo 0)"
SERVICE=0
tmp=""

usage() {
  cat <<EOF
usage: webcontrol-update [--repo owner/name] [--version vX.Y.Z] [--force]
       webcontrol-update --rollback | --status | --help
       webcontrol-update --service update|rollback

With no flags, installs the latest published release of $REPO if it is newer
than the installed webcontrol-rs. Versions compare as MAJOR.MINOR.PATCH, field
by field as numbers; a pre-release such as 1.2.0-rc.1 comes before 1.2.0, and a
build from git describe such as 1.2.0-3-gabc1234 after it. If the installed
version is newer than the latest release it changes nothing; --version installs
an older release on purpose. To update, it checks the machine is idle, downloads the
release's tarball and SHA256SUMS, verifies the checksum, backs up the current
install, runs the release's install-pi.sh, restarts webcontrol-rs and checks it
for up to ${WAIT}s. If that check fails it restores the backup by itself. While
webcontrol.service (an older WebControl) runs, it installs or restores the
files without restarting anything; wc-switch rust starts them when it is idle.

Only PUBLISHED releases are seen. GitHub hides draft releases from anyone
without write access, so publish the draft first.

  --repo owner/name   the GitHub repository (or set WEBCONTROL_REPO)
  --version vX.Y.Z    install this release tag instead of the latest
  --force             reinstall even if that version is installed (it never
                      downgrades; only --version does)
  --rollback          restore the backup the last update made (it is kept)
  --status            show the installed version, the backup, the latest release
                      and whether it is an update
  --help              this text
  --service ACTION    what webcontrol-update@ACTION.service runs for the UI:
                      as root, with no prompts, the repository and token from
                      webcontrol-rs's environment, and progress in
                      $status_file

The backup is one slot, $backup: the binary, the systemd units and
drop-in, wc-switch, webcontrol-update, the sudoers rule and webcontrol.json.
Each update replaces it. GITHUB_TOKEN, if set, is sent to the GitHub API.
EOF
}

say() {
  printf '%s\n' "$*"
  log_line "$*"
}
fail() {
  printf 'webcontrol-update: %s\n' "$*" >&2
  log_line "$*"
  exit 1
}

root_do() { if [ "$AS_ROOT" = 1 ]; then "$@"; else sudo "$@"; fi; }

json_text() {
  local text="${1//\\/\\\\}"
  text="${text//\"/\\\"}"
  printf '"%s"' "$(printf '%s' "${text//$'\t'/ }" | tr -d '\000-\037')"
}

json_or_null() { if [ -n "$1" ]; then json_text "$1"; else printf null; fi; }

# The progress the server shows; replaced whole, so it never reads half a file.
write_status() {
  [ "$SERVICE" = 1 ] || return 0
  printf '{"action":"%s","phase":"%s","from":%s,"to":%s,"startedAt":%s,"finishedAt":%s,"result":%s,"log":[%s]}\n' \
    "$ACTION" "$PHASE" "$(json_or_null "$FROM")" "$(json_or_null "$TO")" "$STARTED" "${FINISHED:-null}" \
    "$(json_or_null "$RESULT")" "$LOG_JSON" > "$status_file.new" &&
    chmod 644 "$status_file.new" && mv -f "$status_file.new" "$status_file"
}

log_line() {
  [ "$SERVICE" = 1 ] || return 0
  LOG_JSON="${LOG_JSON:+$LOG_JSON,}$(json_text "$1")"
  write_status
}

phase() {
  PHASE="$1"
  write_status
}

# shellcheck disable=SC2329 # The EXIT trap runs it.
on_exit() {
  [ -z "$tmp" ] || rm -rf "$tmp"
  [ "$SERVICE" = 1 ] || return 0
  RESULT="${RESULT:-failed}"
  FINISHED="$(date +%s)000"
  phase finished
}

# The first key named $2 at any depth: a string's contents, or a bare true/false/number. jq is not on every Pi.
field() {
  grep -oE '"([^"\\]|\\.)*"|[][{},:]|[^][{},:"[:space:]]+' <<< "$1" | awk -v key="\"$2\"" '
    want == 2 {
      if ($0 ~ /^"/) { $0 = substr($0, 2, length($0) - 2); gsub(/\\"/, "\""); gsub(/\\\\/, "\\") }
      if ($0 != "{" && $0 != "[") printf "%s", $0
      exit
    }
    { want = (want == 1 && $0 == ":") ? 2 : ($0 == key) }' || true
}

service_user() {
  local user
  user="$(sed -n 's/^User=//p' "$unit" 2> /dev/null | head -n 1 || true)"
  echo "${WC_USER:-${user:-$(id -un)}}"
}

service_home() {
  local home
  home="$(getent passwd "$1" 2> /dev/null | cut -d: -f6 || true)"
  echo "${WC_HOME:-${home:-$HOME}}"
}

state_url() {
  local port
  port="$(grep -oE -- '--port[= ]+[0-9]+' "$unit" 2> /dev/null | grep -oE '[0-9]+$' | head -n 1 || true)"
  echo "${WC_URL:-http://localhost:${port:-5000}}"
}

api_state() { curl -fsS --max-time 3 "$URL/api/state" 2> /dev/null || true; }

rust_active() { systemctl is-active --quiet webcontrol-rs 2> /dev/null; }

# Starting webcontrol-rs would stop it (Conflicts=), and it may be mid-job: v0.94 has no /api/state to ask.
python_active() { systemctl is-active --quiet webcontrol 2> /dev/null; }
PYTHON_RUNNING="webcontrol.service, an older WebControl, is running and keeps port 5000. When it is idle: wc-switch rust"

installed_version() { "$binary" --version 2> /dev/null | awk '{ print $2 }' || true; }

manifest_value() { sed -n "s/^$1=//p" "$backup/MANIFEST" 2> /dev/null | head -n 1 || true; }

is_zero() { [[ "${1:-0}" =~ ^0*(\.0*)?$ ]]; }

# Prints -1, 0 or 1.
compare_text() {
  local LC_ALL=C
  if [ "$1" = "$2" ]; then echo 0; elif [[ "$1" < "$2" ]]; then echo -1; else echo 1; fi
}

# compare_text for two digit strings of any length, so none overflows.
compare_numbers() {
  local a="${1#"${1%%[!0]*}"}" b="${2#"${2%%[!0]*}"}"
  [ "${#a}" = "${#b}" ] || { [ "${#a}" -lt "${#b}" ] && echo -1 || echo 1; return 0; }
  compare_text "$a" "$b"
}

# Semver identifier order: numbers numerically and below words, which compare in ASCII.
compare_identifiers() {
  local a_num=0 b_num=0
  [[ ! "$1" =~ ^[0-9]+$ ]] || a_num=1
  [[ ! "$2" =~ ^[0-9]+$ ]] || b_num=1
  [ "$a_num$b_num" != 11 ] || { compare_numbers "$1" "$2"; return 0; }
  [ "$a_num" = "$b_num" ] || { [ "$a_num" = 1 ] && echo -1 || echo 1; return 0; }
  compare_text "$1" "$2"
}

compare_prereleases() {
  local -a a b
  local i order
  IFS=. read -ra a <<< "$1"
  IFS=. read -ra b <<< "$2"
  for ((i = 0; i < ${#a[@]} || i < ${#b[@]}; i++)); do
    [ "$i" -lt "${#a[@]}" ] || { echo -1; return 0; }
    [ "$i" -lt "${#b[@]}" ] || { echo 1; return 0; }
    order="$(compare_identifiers "${a[i]}" "${b[i]}")"
    [ "$order" = 0 ] || { echo "$order"; return 0; }
  done
  echo 0
}

# Sets V_CORE, V_PRE (the pre-release) and V_DESC (git describe's commit count past the tag); fails on a non-version.
parse_version() {
  [[ "$1" =~ $VERSION_RE ]] || return 1
  V_CORE=("${BASH_REMATCH[1]}" "${BASH_REMATCH[3]:-0}" "${BASH_REMATCH[5]:-0}")
  V_PRE="${BASH_REMATCH[7]}"
  V_DESC=""
  case "$V_PRE" in dirty | *-dirty) V_PRE="${V_PRE%dirty}"; V_PRE="${V_PRE%-}"; V_DESC=0 ;; esac
  [[ ! "$V_PRE" =~ ^(.*-)?([0-9]+)-g[0-9a-f]+$ ]] || { V_PRE="${BASH_REMATCH[1]%-}"; V_DESC="${BASH_REMATCH[2]}"; }
}

# compare_presence <a> <b> <order of an empty a>: prints 0 when both or neither are empty.
compare_presence() {
  [ -z "$1" ] && [ -n "$2" ] && { echo "$3"; return 0; }
  [ -n "$1" ] && [ -z "$2" ] && { echo "$((0 - $3))"; return 0; }
  echo 0
}

# version_order <a> <b>: prints older, same or newer for a against b, or unknown if either is not a version.
version_order() {
  local -a core
  local pre desc i order=0
  parse_version "$1" || { echo unknown; return 0; }
  core=("${V_CORE[@]}")
  pre="$V_PRE"
  desc="$V_DESC"
  parse_version "$2" || { echo unknown; return 0; }
  for i in 0 1 2; do
    [ "$order" != 0 ] || order="$(compare_numbers "${core[i]}" "${V_CORE[i]}")"
  done
  [ "$order" != 0 ] || order="$(compare_presence "$pre" "$V_PRE" 1)"
  [ "$order" != 0 ] || order="$(compare_prereleases "$pre" "$V_PRE")"
  [ "$order" != 0 ] || order="$(compare_presence "$desc" "$V_DESC" -1)"
  [ "$order" != 0 ] || order="$(compare_numbers "$desc" "$V_DESC")"
  case "$order" in -1) echo older ;; 0) echo same ;; *) echo newer ;; esac
}

# Sets ARCH, which names the release asset to install.
preflight() {
  local tool
  ARCH="$(uname -m)"
  case "$ARCH" in
    aarch64 | x86_64) ;;
    *) fail "webcontrol-rs is built for aarch64 (the Pi) and x86_64 Linux; this machine is $ARCH." ;;
  esac
  for tool in curl sha256sum tar; do
    command -v "$tool" > /dev/null || fail "$tool is needed: sudo apt-get install $tool"
  done
}

busy_reason() {
  local body="$1" info stage reason
  if [ -z "$body" ]; then
    rust_active && echo "webcontrol-rs is running but not answering at $URL, so it may be mid-job" \
      "(if you are sure it is not, root_do systemctl stop webcontrol-rs first)"
    return 0
  fi
  [ "$(field "$body" jobInProgress)" = true ] && { echo "a job is running or paused"; return; }
  [ "$(field "$body" pauseButtonSetting)" = Resume ] && { echo "a job or tool change is held, waiting for Resume"; return; }
  [ "$(field "$body" manualZAxisAdjust)" = true ] && { echo "the controller is waiting for a tool change or a Z adjustment"; return; }
  [ "$(field "$body" probing)" = true ] && { echo "a Z probe is in flight"; return; }
  info="$(curl -fsS --max-time 3 "$URL/api/system/info" 2> /dev/null || true)"
  stage="$(field "$info" stage)"
  case "$stage" in
    backingUp | flashing | restarting | migrating | selfTest | testing | rollingBack)
      echo "a controller firmware upgrade is underway ($stage)"; return ;;
  esac
  # Only the server's own check sees an optical scan; it may wait on GitHub first.
  info="$(curl -fsS --max-time 15 "$URL/api/system/updates" 2> /dev/null || true)"
  reason="$(field "$info" busy)"
  reason="${reason#Not now: }"
  [ -z "$reason" ] || [ "$reason" = null ] || echo "${reason%. Finish or stop it first.}"
}

# Sets EXPECT_CONTROLLER: a controller that answered before the restart must answer again after it.
require_idle() {
  local body reason
  EXPECT_CONTROLLER=0
  body="$(api_state)"
  [ -n "$body" ] || { sleep "$POLL"; body="$(api_state)"; }
  reason="$(busy_reason "$body")"
  [ -z "$reason" ] || fail "Not now: $reason. Finish or stop it, then run webcontrol-update again."
  if [ -z "$body" ]; then
    python_active && say "webcontrol.service, an older WebControl, is running; it is left running."
    python_active || say "webcontrol-rs is not running, so no job is; carrying on."
    return 0
  fi
  if is_zero "$(field "$body" controllerFirmwareVersion)"; then
    say "Warning: no controller is connected, so the health check will not wait for one."
  else
    EXPECT_CONTROLLER=1
  fi
}

# The token goes to curl on stdin, so it never shows in ps.
github() {
  { [ -z "${GITHUB_TOKEN:-}" ] || printf 'header = "Authorization: Bearer %s"\n' "$GITHUB_TOKEN"; } |
    curl -K - -fsSL --max-time 30 -H "Accept: application/vnd.github+json" "$API/repos/$REPO/releases/$1"
}

# Sets RELEASE_JSON and VERSION (the tag without its v).
find_release() {
  local tag
  if [ -n "$PIN" ]; then
    tag="v${PIN#v}"
    RELEASE_JSON="$(github "tags/$tag")" ||
      fail "No published release $tag in $REPO. Drafts are not visible: publish it on GitHub first."
  else
    RELEASE_JSON="$(github latest)" ||
      fail "No published release found in $REPO. Drafts are not visible: publish the release on GitHub first."
  fi
  tag="$(field "$RELEASE_JSON" tag_name)"
  [[ "$tag" =~ $TAG_RE ]] || fail "The release's tag \"$tag\" is not a version."
  VERSION="${tag#v}"
}

asset_url() {
  grep -oE '"browser_download_url": *"[^"]*"' <<< "$RELEASE_JSON" | sed -E 's/.*: *"([^"]*)"$/\1/' |
    awk -v n="/$1" 'substr($0, length($0) - length(n) + 1) == n { print; exit }' || true
}

# Leaves the checked release unpacked in $STAGE.
download_and_check() {
  local name="webcontrol-rs-$VERSION-$ARCH" url sums want got listing file
  phase downloading
  for file in "$name.tar.gz" SHA256SUMS; do
    url="$(asset_url "$file")"
    [ -n "$url" ] || fail "Release v$VERSION has no $file asset."
    say "Downloading $file"
    curl -fsSL --retry 2 -o "$tmp/$file" "$url" || fail "Could not download $url"
  done
  sums="$tmp/SHA256SUMS"
  want="$(awk -v n="$name.tar.gz" '$2 == n || $2 == "*" n { print $1; exit }' "$sums")"
  [ -n "$want" ] || fail "SHA256SUMS does not list $name.tar.gz. Nothing was changed."
  got="$(sha256sum "$tmp/$name.tar.gz" | cut -d' ' -f1)"
  [ "$got" = "$want" ] || fail "Checksum mismatch for $name.tar.gz (got $got, SHA256SUMS says $want). Nothing was changed."
  say "Checksum OK."
  phase verified
  listing="$(tar -tzf "$tmp/$name.tar.gz" | sed 's|/$||')" || fail "$name.tar.gz is not a readable tarball."
  ! tar -tvzf "$tmp/$name.tar.gz" | grep -qE '^[lh]| link to ' || fail "$name.tar.gz holds a link; a release has none."
  while IFS= read -r file; do
    case "$file" in "$name" | "$name"/*) ;; *) fail "$name.tar.gz holds $file, outside $name/." ;; esac
    case "/$file/" in */../*) fail "$name.tar.gz holds $file, which climbs out of it." ;; esac
  done <<< "$listing"
  for file in "${release_files[@]}"; do
    grep -qxF "$name/$file" <<< "$listing" || fail "$name.tar.gz has no $file."
  done
  tar -C "$tmp" -xzf "$tmp/$name.tar.gz"
  STAGE="$tmp/$name"
  [ "$("$STAGE/webcontrol-rs" --version 2> /dev/null | awk '{ print $2 }')" = "$VERSION" ] ||
    fail "The release's webcontrol-rs does not run here or does not report $VERSION. Nothing was changed."
}

settings_path() { echo "$(service_home "$(service_user)")/.WebControl/webcontrol.json"; }

# As root, the settings are read and written as their owner, so a link the owner plants there cannot redirect root.
as_owner() { runuser -u "$(service_user)" -- "$@"; }
owns_settings() { [ "$AS_ROOT" = 0 ] || [ "$1" != "$(settings_path)" ]; }

back_up() {
  if owns_settings "$1"; then root_do cp -p "$1" "$2"; else as_owner cat "$1" > "$2"; fi
}

# put_back <from> <to>: by a rename, so a running copy of this script keeps reading the file it started from.
put_back() {
  if owns_settings "$2"; then
    root_do mkdir -p "$(dirname "$2")" && root_do cp -p "$1" "$2.wc-restore" && root_do mv -f "$2.wc-restore" "$2"
  else
    as_owner mkdir -p "$(dirname "$2")" && as_owner rm -f "$2.wc-restore" &&
      as_owner tee "$2.wc-restore" < "$1" > /dev/null && as_owner mv -f "$2.wc-restore" "$2"
  fi
}

backed_up_paths() {
  printf '%s\n' "$binary" "$unit" "$dropin" "$bindir/wc-switch" "$bindir/webcontrol-update" "$sudoers" "$update_unit" \
    "$(settings_path)"
}

# Sets BACKED_UP to the version saved, or empty when nothing was installed.
make_backup() {
  local current path manifest next="$backup.new"
  BACKED_UP=""
  current="$(installed_version)"
  phase backingUp
  if [ ! -e "$binary" ]; then
    say "webcontrol-rs is not installed yet, so there is nothing to back up."
    return 0
  fi
  manifest="$(printf 'version=%s\ndate=%s\n' "${current:-unknown}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)")"
  root_do rm -rf "$next"
  root_do install -d "$next/files"
  while IFS= read -r path; do
    [ -e "$path" ] || continue
    root_do mkdir -p "$next/files$(dirname "$path")"
    back_up "$path" "$next/files$path"
    manifest="$manifest"$'\n'"file=$path"
  done < <(backed_up_paths)
  # Written last: a backup without a MANIFEST is incomplete and is never restored.
  printf '%s\n' "$manifest" | root_do tee "$next/MANIFEST" > /dev/null
  if [ -f "$backup/MANIFEST" ]; then
    say "Deleting the previous backup (webcontrol-rs $(manifest_value version), made $(manifest_value date))."
  elif [ -e "$backup" ]; then
    say "Deleting an incomplete previous backup."
  fi
  root_do rm -rf "$backup"
  root_do mv "$next" "$backup"
  BACKED_UP="${current:-unknown}"
  say "Backed up webcontrol-rs ${current:-unknown} to $backup."
}

# restore_backup [path to leave alone]: fails if any file could not be put back.
restore_backup() {
  local line path from failed=0
  while IFS= read -r line; do
    path="${line#file=}"
    from="$backup/files$path"
    [ "$path" != "${1:-}" ] || continue
    if [ "$path" = "$sudoers" ] && ! root_do visudo -cqf "$from" > /dev/null 2>&1; then
      say "  NOT restored $path: it does not pass visudo -c, and a broken rule would lock sudo out"
      failed=1
      continue
    fi
    if put_back "$from" "$path"; then
      say "  restored $path"
    else
      say "  NOT restored $path"
      failed=1
    fi
  done < <(grep '^file=' "$backup/MANIFEST")
  root_do systemctl daemon-reload || failed=1
  return "$failed"
}

restart() {
  phase restarting
  say "Restarting webcontrol-rs."
  # A release that crash-looped leaves the unit at its start limit, which would refuse the restored one.
  root_do systemctl reset-failed webcontrol-rs 2> /dev/null || true
  root_do systemctl restart webcontrol-rs
}

# healthy <version>: waits up to $WAIT s for the service, /api/state and the controller.
healthy() {
  local want="$1" active body backend version ok
  phase healthCheck
  say "Checking webcontrol-rs for up to ${WAIT}s."
  local deadline=$((SECONDS + WAIT))
  while :; do
    active="$(systemctl is-active webcontrol-rs 2> /dev/null || true)"
    body="$(api_state)"
    backend="$(field "$body" backend)"
    version="$(field "$body" version)"
    ok=0
    [ "$active" = active ] && [ "$backend" = rust ] && [ "$version" = "$want" ] && ok=1
    if [ "$ok" = 1 ] && [ "$EXPECT_CONTROLLER" = 1 ] && is_zero "$(field "$body" controllerFirmwareVersion)"; then ok=2; fi
    if [ "$ok" = 1 ]; then
      say "webcontrol-rs $want is running and answering at $URL$([ "$EXPECT_CONTROLLER" = 1 ] && echo ", with the controller connected")."
      return 0
    fi
    [ "$SECONDS" -lt "$deadline" ] || break
    sleep "$POLL"
  done
  say "Health check failed after ${WAIT}s:"
  say "  service: ${active:-unknown}"
  [ -n "$body" ] && say "  $URL/api/state: backend \"$backend\", version \"$version\" (wanted rust, $want)"
  [ -n "$body" ] || say "  $URL/api/state: no answer"
  [ "$ok" = 2 ] && say "  the controller did not reconnect"
  say "  journalctl -u webcontrol-rs -n 50 shows the service's log."
  return 1
}

roll_back_and_check() {
  local version restored=1
  version="$(manifest_value version)"
  phase rollingBack
  say "Restoring the backup of webcontrol-rs $version from $backup:"
  # Stopped first, so the failed version cannot write webcontrol.json over the restored one.
  root_do systemctl stop webcontrol-rs || true
  restore_backup || restored=0
  if python_active; then
    say "$PYTHON_RUNNING"
    if [ "$restored" = 1 ]; then
      say "ROLLED BACK: the files of webcontrol-rs $version are back, not started."
      RESULT=rolledBack
      return 0
    fi
  else
    restart || true
    if healthy "$version" && [ "$restored" = 1 ]; then
      say "ROLLED BACK: webcontrol-rs $version is running again, with its settings."
      RESULT=rolledBack
      return 0
    fi
  fi
  RESULT=rollbackFailed
  if [ "$restored" = 0 ]; then
    say "ROLLBACK INCOMPLETE: the files marked NOT restored above are still the new version's."
    say "Their backups are under $backup/files."
    return 1
  fi
  say "ROLLBACK FAILED: webcontrol-rs $version did not come back healthy either."
  say "The deeper fallback is the SSD or the old card: power off, boot from it, and look at this card later."
  return 1
}

update() {
  local current order
  preflight
  require_idle
  find_release
  current="$(installed_version)"
  FROM="$current"
  TO="$VERSION"
  order="$(version_order "$current" "$VERSION")"
  if [ -n "$current" ] && [ "$order" = unknown ]; then
    say "Warning: cannot compare the installed version \"$current\" with $VERSION, so any other version counts as newer."
    order="$([ "$current" = "$VERSION" ] && echo same || echo older)"
  fi
  if [ "$order" = newer ] && [ -z "$PIN" ]; then
    say "Installed $current is newer than the latest published release $VERSION; nothing to do. Use --version v$VERSION to install it anyway."
    RESULT=upToDate
    return 0
  fi
  [ "$order" != newer ] || say "Warning: $VERSION is older than the installed $current; installing it because --version asked for it."
  if [ "$order" = same ] && [ "$FORCE" = 0 ]; then
    say "webcontrol-rs $VERSION is installed$([ -z "$PIN" ] && echo ", the latest published release of $REPO"). Nothing to do (--force reinstalls it)."
    RESULT=upToDate
    return 0
  fi
  say "Updating webcontrol-rs ${current:-(not installed)} to $VERSION from $REPO."
  [ "$AS_ROOT" = 1 ] || sudo -v
  tmp="$(mktemp -d)"
  download_and_check
  make_backup
  export WC_USER
  WC_USER="$(service_user)"
  local installed=1 reason
  phase installing
  bash "$STAGE/install-pi.sh" "$STAGE" || installed=0
  if [ "$installed" = 1 ] && python_active; then
    say "Installed webcontrol-rs $VERSION without starting it: $PYTHON_RUNNING"
    RESULT=updated
    return 0
  fi
  if [ "$installed" = 1 ]; then
    reason="$(busy_reason "$(api_state)")"
    [ -z "$reason" ] || job_started_during_the_update "$reason"
  fi
  if [ "$installed" = 1 ] && restart && healthy "$VERSION"; then
    say "Updated webcontrol-rs to $VERSION."
    RESULT=updated
    [ -n "$BACKED_UP" ] && say "The backup of $BACKED_UP stays in $backup; webcontrol-update --rollback restores it."
    return 0
  fi
  [ "$installed" = 1 ] || say "install-pi.sh failed."
  if [ -z "$BACKED_UP" ]; then
    say "UPDATE FAILED, and there was no earlier install to roll back to."
    return 1
  fi
  say "UPDATE FAILED: rolling back to webcontrol-rs $BACKED_UP."
  roll_back_and_check || return 1
  say "The update to $VERSION did not take; webcontrol-rs $BACKED_UP is back."
  return 1
}

# The running process is still the old one, so only the files go back; install-pi.sh never touches webcontrol.json.
job_started_during_the_update() {
  [ -n "$BACKED_UP" ] || fail "Not restarting: $1. webcontrol-rs $VERSION is installed but not started."
  say "Not restarting: $1. Putting the files of webcontrol-rs $BACKED_UP back:"
  restore_backup "$(settings_path)" || fail "Some files could not be put back; webcontrol-update --rollback when idle."
  fail "Nothing was restarted. Run webcontrol-update again when the machine is idle."
}

rollback() {
  preflight
  require_idle
  [ -f "$backup/MANIFEST" ] || fail "There is no backup in $backup to roll back to."
  [ "$AS_ROOT" = 1 ] || sudo -v
  FROM="$(installed_version)"
  TO="$(manifest_value version)"
  say "Rolling back webcontrol-rs $(installed_version) to $(manifest_value version) (backed up $(manifest_value date))."
  roll_back_and_check || return 1
  say "The backup stays in $backup; the next update replaces it."
}

update_status() {
  [ -n "$1" ] || { echo "not installed; webcontrol-update installs v$2"; return 0; }
  case "$(version_order "$1" "$2")" in
    older) echo "update available: webcontrol-update installs v$2" ;;
    same) echo "up to date" ;;
    newer) echo "installed $1 is newer than latest published $2; nothing to update" ;;
    *) echo "unknown: cannot compare \"$1\" with $2" ;;
  esac
}

status() {
  local latest installed tag
  installed="$(installed_version)"
  say "Installed:       ${installed:+webcontrol-rs }${installed:-none}"
  say "Service:         $(systemctl is-active webcontrol-rs 2> /dev/null || true)"
  if [ -f "$backup/MANIFEST" ]; then
    say "Backup:          webcontrol-rs $(manifest_value version), made $(manifest_value date), in $backup"
  else
    say "Backup:          none"
  fi
  if latest="$(github latest 2> /dev/null)"; then
    tag="$(field "$latest" tag_name)"
    say "Latest release:  $tag ($REPO)"
    say "Update:          $(update_status "$installed" "${tag#v}")"
  else
    say "Latest release:  none published in $REPO (drafts are not visible)"
  fi
}

# The unit's environment is systemd's, so the repository and token come from webcontrol-rs's, as the server's do.
service_env() {
  local -a words
  local word
  read -ra words <<< "$(systemctl show -p Environment --value webcontrol-rs 2> /dev/null || true)"
  for word in ${words[@]+"${words[@]}"}; do
    case "$word" in
      WEBCONTROL_REPO=*) REPO="${word#*=}" ;;
      WC_GITHUB_API=*) API="${word#*=}" ;;
      GITHUB_TOKEN=*) export GITHUB_TOKEN="${word#*=}" ;;
    esac
  done
}

check_repo() {
  [[ "$REPO" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$ && ! "$REPO" =~ /\.\.?$ ]] || fail "--repo takes owner/name, not \"$REPO\"."
}

# One run at a time; a second one leaves the first one's status file alone.
take_lock() {
  command -v flock > /dev/null || return 0
  exec 9> "$states/update.lock"
  flock -n 9 || fail "An update or rollback is already running."
}

service() {
  case "$1" in update | rollback) ;; *) fail "--service takes update or rollback, not \"$1\"." ;; esac
  [ "$AS_ROOT" = 1 ] || fail "--service is for webcontrol-update@.service, which runs as root."
  service_env
  install -d -m 755 "$states"
  take_lock
  ACTION="$1"
  PHASE=checking
  STARTED="$(date +%s)000"
  FROM=""
  TO=""
  RESULT=""
  FINISHED=""
  LOG_JSON=""
  SERVICE=1
  write_status
  check_repo
  PIN=""
  FORCE=0
  "$1"
}

main() {
  local mode=update
  PIN=""
  FORCE=0
  trap on_exit EXIT
  if [ "${1:-}" = --service ]; then
    [ $# = 2 ] || fail "--service takes update or rollback and nothing else."
    URL="$(state_url)"
    service "$2"
    return
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="${2:?--repo needs owner/name}"; shift ;;
      --repo=*) REPO="${1#--repo=}" ;;
      --version) PIN="${2:?--version needs a tag, such as v0.2.0}"; shift ;;
      --version=*) PIN="${1#--version=}" ;;
      --force) FORCE=1 ;;
      --rollback) mode=rollback ;;
      --status) mode=status ;;
      -h | --help) usage; return 0 ;;
      *) usage >&2; return 2 ;;
    esac
    shift
  done
  check_repo
  [[ -z "$PIN" || "$PIN" =~ $TAG_RE ]] || fail "--version takes a release tag such as v0.2.0, not \"$PIN\"."
  URL="$(state_url)"
  case "$mode" in
    update) update ;;
    rollback) rollback ;;
    status) status ;;
  esac
}

# On one line, so bash has read it all before install-pi.sh replaces this file.
main "$@"; exit $?
