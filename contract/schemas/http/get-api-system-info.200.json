{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get-api-system-info.200",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "controllerFirmwareVersion": {
      "type": "number"
    },
    "firmware": {
      "type": "object",
      "properties": {
        "stock": {
          "type": [
            "string",
            "null"
          ]
        },
        "holey": {
          "type": [
            "string",
            "null"
          ]
        },
        "custom": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stock",
        "holey",
        "custom"
      ]
    },
    "canTurnOff": {
      "type": "boolean"
    },
    "fourMotor": {
      "type": "boolean"
    },
    "firmwareBuild": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "firmwareSupportsZaxisLimit": {
      "default": false,
      "type": "boolean"
    },
    "update": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "version"
      ]
    },
    "firmwareUpgrade": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "imageSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "idle",
            "checking",
            "ready",
            "blocked",
            "backingUp",
            "flashing",
            "restarting",
            "migrating",
            "selfTest",
            "testing",
            "done",
            "failed",
            "rollingBack",
            "rolledBack"
          ]
        },
        "message": {
          "type": "string"
        },
        "board": {
          "type": [
            "string",
            "null"
          ]
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ]
        },
        "chains": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "left": {
                  "type": "number"
                },
                "right": {
                  "type": "number"
                }
              },
              "required": [
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "chainsAfter": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "left": {
                  "type": "number"
                },
                "right": {
                  "type": "number"
                }
              },
              "required": [
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "motors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "motor": {
                "type": "string"
              },
              "passed": {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              }
            },
            "required": [
              "motor",
              "passed"
            ]
          }
        },
        "backup": {
          "type": [
            "string",
            "null"
          ]
        },
        "canRollback": {
          "type": "boolean"
        },
        "log": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "target",
        "imageSha256",
        "stage",
        "message",
        "board",
        "firmware",
        "chains",
        "chainsAfter",
        "motors",
        "backup",
        "canRollback",
        "log"
      ]
    }
  },
  "required": [
    "version",
    "platform",
    "controllerFirmwareVersion",
    "firmware",
    "canTurnOff",
    "fourMotor",
    "update"
  ]
}
