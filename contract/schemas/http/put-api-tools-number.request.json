{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "put-api-tools-number.request",
  "type": "object",
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999,
      "description": "The T number the gcode calls it by"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "diameter": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "units": {
      "description": "Required with a diameter",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "mm",
            "in"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "flutes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "number",
    "description"
  ]
}
