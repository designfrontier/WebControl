{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get-api-main.200",
  "type": "object",
  "properties": {
    "status": {
      "type": "object",
      "properties": {
        "uploadFlag": {
          "type": "number"
        },
        "positioningMode": {
          "type": "number"
        },
        "currentTool": {
          "type": "number"
        },
        "jobInProgress": {
          "type": "boolean"
        },
        "manualZAxisAdjust": {
          "type": "boolean"
        },
        "probing": {
          "type": "boolean"
        },
        "stoppedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "uploadFlag",
        "positioningMode",
        "currentTool"
      ]
    },
    "touchPlate": {
      "type": "boolean"
    },
    "gcode": {
      "type": "object",
      "properties": {
        "lineIndex": {
          "type": "number"
        },
        "line": {
          "type": "string"
        },
        "lineCount": {
          "type": "number"
        }
      },
      "required": [
        "lineIndex",
        "line",
        "lineCount"
      ]
    }
  },
  "required": [
    "status",
    "touchPlate",
    "gcode"
  ]
}
