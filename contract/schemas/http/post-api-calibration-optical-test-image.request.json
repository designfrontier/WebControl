{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "post-api-calibration-optical-test-image.request",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "markerX": {
          "type": "number",
          "description": "Printed square size, inches"
        },
        "markerY": {
          "type": "number"
        },
        "scaleX": {
          "type": "number",
          "description": "Printer scale error of the target"
        },
        "scaleY": {
          "type": "number"
        },
        "opticalCenterX": {
          "type": "number",
          "description": "Pixel of the sled reference; 0 means the image centre"
        },
        "opticalCenterY": {
          "type": "number"
        },
        "positionTolerance": {
          "type": "number",
          "description": "mm"
        },
        "tlX": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tlY": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "brX": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "brY": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "calibrationExtents": {
          "type": "string"
        },
        "autoScanDirection": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "0 horizontal serpentine, 1 vertical"
        },
        "gaussianBlurValue": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "cannyLowValue": {
          "type": "number"
        },
        "cannyHighValue": {
          "type": "number"
        },
        "feedRate": {
          "type": "number",
          "description": "mm/min of the G1 moves between squares"
        },
        "settleTime": {
          "type": "number",
          "description": "Seconds to wait after a move before capturing"
        }
      },
      "required": [
        "markerX",
        "markerY",
        "scaleX",
        "scaleY",
        "opticalCenterX",
        "opticalCenterY",
        "positionTolerance",
        "tlX",
        "tlY",
        "brX",
        "brY",
        "calibrationExtents",
        "autoScanDirection",
        "gaussianBlurValue",
        "cannyLowValue",
        "cannyHighValue",
        "feedRate",
        "settleTime"
      ]
    }
  },
  "required": [
    "settings"
  ]
}
