{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "frame",
  "type": "object",
  "properties": {
    "ns": {
      "type": "string",
      "description": "The namespace, e.g. \"/MaslowCNC\""
    },
    "event": {
      "type": "string",
      "description": "The socket event name, e.g. \"message\" or \"action\""
    },
    "data": {
      "description": "The payload socket.io would carry as the event's single argument"
    }
  },
  "required": [
    "ns",
    "event",
    "data"
  ]
}
