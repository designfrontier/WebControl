{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "moveGcodeGoto",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "moveGcodeGoto"
        },
        "arg": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^\\s*[-+]?\\d+\\s*$"
            }
          ],
          "description": "Zero-based line index"
        },
        "arg1": {
          "description": "Ignored by the backend; the UI sends \"\".",
