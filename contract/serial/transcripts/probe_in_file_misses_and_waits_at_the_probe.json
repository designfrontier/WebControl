    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G38.2 Z-10 F100  \n"},
    {"type": "rx", "line": "probing for z axis zero"},
    {"type": "rx", "line": "max depth -10.00 mm."},
    {"type": "rx", "line": "feedrate 60.00 mm per min."},
