    "name": "probe_in_file_misses_and_waits_at_the_probe",
    "description": "A G38.2 from the file that never touches: the firmware's `error: probe did not connect` answers it and the firmware stops (`sys.stop`). The job is held at the probe line with the Touch Z Failed alert, and Play returns at safe height and probes again. Python streams on after the miss.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "610e5bf"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "gcode": {
      "lines": [
        "G21",
        "G0 Z5",
        "G38.2 Z-10 F100",
        "G1 Z-1 F200",
        "G1 X10 Y0"
      ]
    }
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "ok"},
