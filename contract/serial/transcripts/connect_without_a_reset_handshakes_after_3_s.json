{
  "formatVersion": 1,
  "meta": {
    "name": "connect_without_a_reset_handshakes_after_3_s",
    "description": "A board that does not reset when the port opens prints no banner and no boot ok, only its status reports. After 3 s without either WebControl sends the handshake anyway, with the B05 and $13 a banner would have queued.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "c1400bd"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "start": "boot"
  },
  "events": [
    {"type": "rx", "line": "<Idle,MPos:0.00,0.00,0.00,WPos:0.000,0.000,0.000>"},
    {"type": "tick", "seconds": 1.0, "comment": "no banner, no ok"},
    {"type": "rx", "line": "<Idle,MPos:0.00,0.00,0.00,WPos:0.000,0.000,0.000>"},
    {"type": "tick", "seconds": 1.0},
    {"type": "rx", "line": "<Idle,MPos:0.00,0.00,0.00,WPos:0.000,0.000,0.000>"},
    {"type": "tick", "seconds": 1.0, "comment": "3 s after the port opened the handshake goes out"},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "$$ \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "B05  \n"},
    {"type": "rx", "line": "Firmware Version 51.27"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "$13=63.5000 \n"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"firmwareBuild": "51.27"}, "emitted": [{"command": "controllerMessage", "data": "Firmware Version 51.27"}]}
  ]
}
