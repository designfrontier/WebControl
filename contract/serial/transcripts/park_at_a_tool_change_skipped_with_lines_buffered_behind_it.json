    },
    {
      "type": "rx",
      "line": "M6"
    },
    {
      "type": "rx",
      "line": "Tool Change: Please insert tool 0",
      "comment": "A firmware whose tool WebControl lost track of prompts all the same."
    },
    {
      "type": "rx",
      "line": "Maslow Paused",
      "comment": "No ~: it would run the buffered G1 Z-3 and cuts with the old bit before any park."
    },
    {
      "type": "expect",
      "state": {
        "manualZAxisAdjust": true,
        "jobInProgress": true,
