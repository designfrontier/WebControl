{
  "formatVersion": 1,
  "meta": {
    "name": "optical_scan_two_cells_mm",
    "description": "An optical scan of squares (0, 0) and (1, 0) on a target lying 0.8 mm right of and 0.4 mm below its nominal place (the runner's camera, square-on at 10 px/mm): mm and absolute mode, a raise to the safe height, the camera check's +5 mm X and +5 mm Y moves, then each square with G1 at the feed rate, every move followed by B10 L, whose [Measure reply says the move is done. The first square takes a second move by the measured offset; the second starts from that correction and is centred at once. G90 is restored at the end; a mm machine gets no G20.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "1770dab"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "sled": {
      "x": 0,
      "y": 0,
      "z": 0
    },
    "bootBanner": [
      "PCB v1.1 Detected",
      "Grbl v1.00",
      "ready",
      "ok",
      "[Forward Calculating Position]",
      "position loaded at:",
      "0.00",
      "0.00"
    ]
  },
  "events": [
    {"type": "http", "method": "POST", "path": "/api/calibration/optical/scan", "json": {"settings": {"markerX": 0.6, "markerY": 0.6, "scaleX": 1.0, "scaleY": 1.0, "opticalCenterX": 0.0, "opticalCenterY": 0.0, "positionTolerance": 0.125, "tlX": 0, "tlY": 0, "brX": 1, "brY": 0, "calibrationExtents": "Custom", "autoScanDirection": 0, "gaussianBlurValue": 5, "cannyLowValue": 50.0, "cannyHighValue": 100.0, "feedRate": 500.0, "settleTime": 0.5}}, "status": 200},
    {"type": "tx", "bytes": "G21 \n"},
    {"type": "rx", "line": "G21"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90 \n"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5.0  \n", "comment": "the raise before any travel: the bit is at 0, below the 5 mm safe height"},
    {"type": "rx", "line": "G0 Z5.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X0.0 Y0.0 F500.0 \n", "comment": "the camera check starts over square (0, 0)"},
    {"type": "rx", "line": "G1 X0.0 Y0.0 F500.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "B10 L \n"},
    {"type": "rx", "line": "B10 L"},
    {"type": "rx", "line": "[Measure: 1791.79]"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "emitted": [{"command": "opticalScanProgress", "data": {"state": "orienting", "cell": {"i": 0, "j": 0}}}], "comment": "the camera check reports as orienting while it moves, settles and looks"},
    {"type": "tick", "seconds": 0.5, "comment": "the 0.5 s settle; the camera then looks"},
    {"type": "tx", "bytes": "G1 X5.0 Y0.0 F500.0 \n", "comment": "after the settle and the camera's look"},
    {"type": "rx", "line": "G1 X5.0 Y0.0 F500.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "B10 L \n"},
    {"type": "rx", "line": "B10 L"},
    {"type": "rx", "line": "[Measure: 1795.53]"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X0.0 Y5.0 F500.0 \n"},
    {"type": "rx", "line": "G1 X0.0 Y5.0 F500.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "B10 L \n"},
    {"type": "rx", "line": "B10 L"},
    {"type": "rx", "line": "[Measure: 1788.52]"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X0.0 Y0.0 F500.0 \n", "comment": "the camera is square-on and not mirrored: square (0, 0), attempt 1"},
    {"type": "expect", "emitted": [{"command": "opticalOrientation", "data": {"rotationDeg": 0, "mirrored": false, "pxPerMm": 10}}]},
    {"type": "rx", "line": "G1 X0.0 Y0.0 F500.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "B10 L \n"},
    {"type": "rx", "line": "B10 L"},
    {"type": "rx", "line": "[Measure: 1791.79]"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X0.8 Y-0.4 F500.0 \n", "comment": "re-homed by the 0.8, -0.4 mm the camera saw"},
    {"type": "rx", "line": "G1 X0.8 Y-0.4 F500.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "B10 L \n"},
    {"type": "rx", "line": "B10 L"},
    {"type": "rx", "line": "[Measure: 1792.07]"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X77.0 Y-0.4 F500.0 \n", "comment": "centred; square (1, 0) starts from the same correction"},
    {"type": "rx", "line": "G1 X77.0 Y-0.4 F500.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "B10 L \n"},
    {"type": "rx", "line": "B10 L"},
    {"type": "rx", "line": "[Measure: 1840.13]"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90 \n", "comment": "the scan is done; the positioning mode it found comes back"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"units": "MM", "positioningMode": "G90", "uploadFlag": 0}, "emitted": [{"command": "opticalScanProgress", "data": {"state": "done", "done": 2, "total": 2}}], "noAlerts": [{"message": ""}]}
  ]
}
