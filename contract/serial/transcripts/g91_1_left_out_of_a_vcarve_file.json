{
  "formatVersion": 1,
  "meta": {
    "name": "g91_1_left_out_of_a_vcarve_file",
    "description": "VCarve posts start with G91.1 (incremental arc centres, which is all the firmware knows), but every firmware truncates the G number to an int and runs it as G91, so the file's absolute G0/G1 would all move relative (spec/firmware.md §9, B19). The G91.1 is left out of what is written (a line with nothing else is not sent at all), and the file's absolute moves go out shifted to home as any absolute line.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "rust"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 10,
      "y": 5
    },
    "gcode": {
      "lines": [
        "G21",
        "G90 G91.1",
        "G91.1",
        "G0 X10 Y10",
        "G1 Z-1 F300",
        "G1 X30 Y10",
        "G2 X40 Y20 I0 J10",
        "G0 Z5"
      ]
    },
    "bootBanner": [
      "PCB v1.1 Detected",
      "Grbl v1.00",
      "ready",
      "ok",
      "[Forward Calculating Position]",
      "position loaded at:",
      "247.79",
      "-5.88"
    ]
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "G21"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90 \n", "comment": "G91.1 left out; the line after it, G91.1 alone, is not sent"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X20 Y15  \n", "comment": "absolute, so shifted to home"},
    {"type": "rx", "line": "G0 X20 Y15"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-1 F300  \n"},
    {"type": "rx", "line": "G1 Z-1 F300"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X40 Y15  \n"},
    {"type": "rx", "line": "G1 X40 Y15"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G2 X50 Y25 I0 J10  \n", "comment": "I and J are offsets, as the firmware reads them"},
    {"type": "rx", "line": "G2 X50 Y25 I0 J10"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "G0 Z5"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"uploadFlag": 0, "jobInProgress": false, "gcodeIndex": 0}}
  ]
}
