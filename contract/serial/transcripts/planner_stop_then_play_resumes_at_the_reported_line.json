{
  "formatVersion": 1,
  "meta": {
    "name": "planner_stop_then_play_resumes_at_the_reported_line",
    "description": "On a planner build every line is acked once queued, so the oldest unacked line says nothing about where the sled is. The [PE:] report names the running line, N10 (file line 6), which the viewer shows. Stop flushes the planner; the job ends with its index at that line, so Play restarts there: M110 numbers the restart from the next number, which returns at safe height and plunges before N10's move goes again.",
    "firmware": {
      "variant": "planner",
      "version": "51.29",
      "build": "51.292"
    },
    "webcontrolCommit": "planner-streaming"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "sled": {
      "x": 0,
      "y": 0,
      "z": 0
    },
    "gcode": {
      "lines": ["G21", "G90", "G0 Z5", "G0 X0 Y0", "G1 Z-2 F120", "G1 X10 Y0 F800", "G1 X10 Y10"]
    }
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "M110 N5\n"},
    {"type": "tx", "bytes": "N5 G21*31\n"},
    {"type": "tx", "bytes": "N6 G90*22\n"},
    {"type": "tx", "bytes": "N7 G0 Z5*97\n"},
    {"type": "tx", "bytes": "N8 G0 X0 Y0*32\n"},
    {"type": "tx", "bytes": "N9 G1 Z-2 F120*17\n"},
    {"type": "tx", "bytes": "N10 G1 X10 Y0 F800*119\n"},
    {"type": "tx", "bytes": "N11 G1 X10 Y10*25\n"},
    {"type": "rx", "line": "ok"},
    {"type": "rx", "line": "G21"},
    {"type": "rx", "line": "ok N5"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok N6"},
    {"type": "rx", "line": "G0 Z5"},
    {"type": "rx", "line": "ok N7"},
    {"type": "rx", "line": "G0 X0 Y0"},
    {"type": "rx", "line": "ok N8"},
    {"type": "rx", "line": "G1 Z-2 F120"},
    {"type": "rx", "line": "ok N9"},
    {"type": "rx", "line": "G1 X10 Y0 F800"},
    {"type": "rx", "line": "ok N10"},
    {"type": "rx", "line": "G1 X10 Y10"},
    {"type": "rx", "line": "ok N11"},
    {"type": "tx", "bytes": "N12 G4 P0*94\n"},
    {"type": "rx", "line": "G4 P0"},
    {"type": "rx", "line": "<Idle,MPos:6.00,0.00,-2.00,WPos:0.000,0.000,0.000>"},
    {"type": "rx", "line": "[PE:0.20,-0.10,127,1650.50,1651.25,10,2]"},
    {"type": "expect", "state": {"jobInProgress": true}, "emitted": [{"command": "gcodePositionMessage", "data": {"gcodeLineIndex": 5}}]},
    {"type": "ui", "action": {"command": "stopRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "!\n", "realtime": true},
    {"type": "rx", "line": "ok"},
    {"type": "rx", "line": "[Forward Calculating Position]"},
    {"type": "rx", "line": "position loaded at:"},
    {"type": "rx", "line": "6.00"},
    {"type": "rx", "line": "0.00"},
    {"type": "expect", "state": {"uploadFlag": 0, "jobInProgress": false, "gcodeIndex": 5}},
    {"type": "tick", "seconds": 0.3, "comment": "the backend ignores acks until a status report after 0.25 s"},
    {"type": "rx", "line": "<Idle,MPos:6.00,0.00,-2.00,WPos:0.000,0.000,0.000>"},
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "M110 N13\n", "comment": "the stop flushed N12; the restart's first line is N13"},
    {"type": "tx", "bytes": "N13 G21*40\n"},
    {"type": "rx", "line": "ok"},
    {"type": "rx", "line": "G21"},
    {"type": "rx", "line": "ok N13"},
    {"type": "tx", "bytes": "N14 G90*37\n"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok N14"},
    {"type": "tx", "bytes": "N15 G0 Z5.0*76\n"},
    {"type": "rx", "line": "G0 Z5.0"},
    {"type": "rx", "line": "ok N15"},
    {"type": "tx", "bytes": "N16 G0 X0.0 Y0.0*31\n"},
    {"type": "rx", "line": "G0 X0.0 Y0.0"},
    {"type": "rx", "line": "ok N16"},
    {"type": "tx", "bytes": "N17 G1 Z-2.0 F120.0*46\n"},
    {"type": "rx", "line": "G1 Z-2.0 F120.0"},
    {"type": "rx", "line": "ok N17"},
    {"type": "tx", "bytes": "N18 G1 F120.0*90\n"},
    {"type": "rx", "line": "G1 F120.0"},
    {"type": "rx", "line": "ok N18"},
    {"type": "tx", "bytes": "N19 G90*40\n"},
    {"type": "tx", "bytes": "N20 G1 X10 Y0 F800*116\n"},
    {"type": "tx", "bytes": "N21 G1 X10 Y10*26\n"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok N19"},
    {"type": "rx", "line": "G1 X10 Y0 F800"},
    {"type": "rx", "line": "ok N20"},
    {"type": "rx", "line": "G1 X10 Y10"},
    {"type": "rx", "line": "ok N21"},
    {"type": "tx", "bytes": "N22 G4 P0*93\n"},
    {"type": "rx", "line": "G4 P0"},
    {"type": "rx", "line": "ok N22"},
    {"type": "expect", "state": {"uploadFlag": 0, "jobInProgress": false, "gcodeIndex": 0}}
  ]
}
