    {"type": "expect", "state": {"jobInProgress": false, "uploadFlag": 0, "positioningMode": "G90"}, "emitted": [{"command": "controllerMessage", "data": "PARK START trigger=file x_mm=-300.0 y_mm=200.5 units=MM x=-300.0 y=200.5"}]}
  ]
