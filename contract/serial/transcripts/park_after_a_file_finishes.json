    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G00 Z5.0 \n", "comment": "The bit is at 3 mm, under the 5 mm safe height, so it rises to 5."},
    {"type": "rx", "line": "G00 Z5.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G00 X-300.0 Y200.5  \n"},
    {"type": "rx", "line": "G00 X-300.0 Y200.5"},
