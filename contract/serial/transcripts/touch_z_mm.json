{
  "formatVersion": 1,
  "meta": {
    "name": "touch_z_mm",
    "description": "Touch Z probes with G38.2 down to the plunge limit; once the probe line's ok shows it touched, Z is zeroed with G10 Z0.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "1d58697"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    }
  },
  "events": [
    {"type": "ui", "action": {"command": "touchZ", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G90 G38.2 Z-10 \n"},
    {"type": "rx", "line": "probing for z axis zero"},
    {"type": "rx", "line": "max depth -10.00 mm."},
    {"type": "rx", "line": "feedrate 39.94 mm per min."},
    {"type": "rx", "line": "z axis zeroed"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G10 Z0  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "noAlerts": [{"title": "Touch Z"}]}
  ]
}
