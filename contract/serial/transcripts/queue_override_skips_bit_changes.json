{
  "formatVersion": 1,
  "meta": {
    "name": "queue_override_skips_bit_changes",
    "description": "Tool 1 is changed by hand, then two files are queued, the second with its bit-change override on. The second names tool 2, so without the override it would wait at the prompt; with it, it starts once Z has risen, with no M5 or T2 M6. Its own T2 M6 line is never sent, and its T3 M6 G0 X60 goes out as G0 X60, so the firmware never waits for a tool. Each skipped change is logged with its line, and the firmware keeps tool 1.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "98658f4"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "sled": {
      "x": 0,
      "y": 0,
      "z": 0
    },
    "bootBanner": [
      "PCB v1.1 Detected",
      "Grbl v1.00",
      "ready",
      "ok",
      "[Forward Calculating Position]",
      "position loaded at:",
      "247.79",
      "-5.88"
    ]
  },
  "events": [
    {"type": "http", "method": "POST", "path": "/sendGCode", "form": {"gcode": "T1 M6"}, "status": 200, "comment": "Tool 1 goes in by hand, so the bit in the spindle is known."},
    {"type": "tx", "bytes": "T1 M6 \n"},
    {"type": "rx", "line": "T1 "},
    {"type": "rx", "line": "Tool change to tool 1"},
    {"type": "rx", "line": "M6"},
    {"type": "rx", "line": "Tool Change: Please insert tool 1"},
    {"type": "rx", "line": "Maslow Paused"},
    {"type": "ui", "action": {"command": "resumeRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "~\n", "realtime": true},
    {"type": "rx", "line": "ok"},
    {"type": "rx", "line": "ok"},
    {"type": "http", "method": "POST", "path": "/api/queue/add", "json": {"file": "gcode/queue_first_t1_mm.nc"}, "status": 200},
    {"type": "http", "method": "POST", "path": "/api/queue/add", "json": {"file": "gcode/queue_override_t2_t3_mm.nc", "skipBitChanges": true}, "status": 200},
    {"type": "expect", "emitted": [{"command": "jobQueue", "data": {"items": [{"between": "sameTool", "skipBitChanges": false}, {"between": "toolChangeSkipped", "tool": 2, "skipBitChanges": true}]}}]},
    {"type": "http", "method": "POST", "path": "/api/queue/continue", "json": {"from": "start"}, "status": 200},
    {"type": "tx", "bytes": "G00 Z5.0 \n"},
    {"type": "rx", "line": "G00 Z5.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "T1 M6  \n"},
    {"type": "rx", "line": "T1 "},
    {"type": "rx", "line": "Tool change to tool 1"},
    {"type": "rx", "line": "M6"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "G21"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "G0 Z5"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X10 Y10  \n"},
    {"type": "rx", "line": "G0 X10 Y10"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-1 F100  \n"},
    {"type": "rx", "line": "G1 Z-1 F100"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X20 F600  \n"},
    {"type": "rx", "line": "G1 X20 F600"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "G0 Z5"},
    {"type": "rx", "line": "ok", "comment": "The first file is done: the second loads and, its override on, starts once Z has risen."},
    {"type": "tx", "bytes": "G00 Z5.0 \n"},
    {"type": "rx", "line": "G00 Z5.0"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "G21"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "G90"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X50 Y10  \n"},
    {"type": "rx", "line": "G0 X50 Y10"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-1 F100  \n"},
    {"type": "rx", "line": "G1 Z-1 F100"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "G0 Z5"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X60  \n"},
    {"type": "rx", "line": "G0 X60"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-1 F100  \n"},
    {"type": "rx", "line": "G1 Z-1 F100"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "G0 Z5"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"jobInProgress": false, "manualZAxisAdjust": false, "currentTool": 1}, "emitted": [{"command": "controllerMessage", "data": "QUEUE BIT CHANGE SKIPPED between_files tool=2"}, {"command": "controllerMessage", "data": "QUEUE BIT CHANGE SKIPPED file_line=2 tool=2"}, {"command": "controllerMessage", "data": "QUEUE BIT CHANGE SKIPPED file_line=8 tool=3"}, {"command": "jobQueue", "data": {"state": "idle", "items": []}}]}
  ]
}
