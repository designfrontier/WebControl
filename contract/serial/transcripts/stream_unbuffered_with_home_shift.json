{
  "formatVersion": 1,
  "meta": {
    "name": "stream_unbuffered_with_home_shift",
    "description": "A short job without buffering: one line at a time, each after the previous ok. Absolute X/Y are shifted by home, keeping the decimals of both (10.5 + 12.3456 = 22.8456, 10.25 - 7.25 = 3.00); the comment line is skipped. The index resets when the file ends.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "c859cea"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 12.3456,
      "y": -7.25
    },
    "gcode": {
      "path": "gcode/square_mm.nc"
    }
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
