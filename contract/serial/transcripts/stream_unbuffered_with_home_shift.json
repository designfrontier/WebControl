    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-1.5 F127  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X42.8456 F600  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Y23.00  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X22.8456  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Y3.00  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "M5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"uploadFlag": 0, "jobInProgress": false, "gcodeIndex": 0}}
