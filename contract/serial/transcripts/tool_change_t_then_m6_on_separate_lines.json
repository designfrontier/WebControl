{
  "formatVersion": 1,
  "meta": {
    "name": "tool_change_t_then_m6_on_separate_lines",
    "description": "T2 and M6 on separate lines: the firmware would run the lone T2 as an empty move and skip the M6, so WebControl does not send the T2 line and leads the M6 with T2.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "8e1c18f"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "gcode": {
      "lines": [
        "G21",
        "G90",
        "G0 X1",
        "T2",
        "M6",
        "G0 X2"
      ]
    }
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X1  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "T2 M6  \n"},
    {"type": "rx", "line": "Tool Change: Please insert tool 2"},
    {"type": "rx", "line": "Maslow Paused"},
    {"type": "expect", "state": {"currentTool": 2, "uploadFlag": 0}},
    {"type": "ui", "action": {"command": "resumeRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "~\n", "realtime": true},
    {"type": "rx", "line": "ok"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5.0  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X1.0 Y0.0  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 F800.0  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X2  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"uploadFlag": 0, "jobInProgress": false, "gcodeIndex": 0}}
  ]
