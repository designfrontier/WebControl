    {"type": "tx", "bytes": "G0 F600.0  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X40 Y40  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-2 F100  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "X50  \n"},
    {"type": "rx", "line": "ok"},
