{
  "formatVersion": 1,
  "meta": {
    "name": "tool_change_t_and_m6_on_one_line",
    "description": "T2 M6: streaming stops after the M6, the firmware asks for tool 2 and holds. Resume sends ~, returns to the file's XY at safe height without lowering the new bit, and streams the rest.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "c859cea"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "gcode": {
      "path": "gcode/tool_change_mm.nc"
    }
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X10 Y10  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-3 F100  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X20 F600  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "T2 M6  \n"},
    {"type": "rx", "line": "Tool Change: Please insert tool 2"},
    {"type": "rx", "line": "Maslow Paused"},
    {"type": "expect", "state": {"uploadFlag": 0, "jobInProgress": true, "manualZAxisAdjust": true, "currentTool": 2}, "emitted": [{"command": "activateModal", "data": {"message": "Please insert tool 2", "resume": "resume"}}]},
    {"type": "ui", "action": {"command": "resumeRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "~\n", "realtime": true},
    {"type": "rx", "line": "ok"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
