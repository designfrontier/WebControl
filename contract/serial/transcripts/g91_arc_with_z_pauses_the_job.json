{
  "formatVersion": 1,
  "meta": {
    "name": "g91_arc_with_z_pauses_the_job",
    "description": "Every firmware's G2/G3 reads Z as absolute even under G91, so a relative helix would plunge to the absolute depth: the line is never sent and the job pauses before it with an alert, as for an unclosed comment.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "rust"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "gcode": {
      "lines": [
        "G21",
        "G0 X10 Y10",
        "G91",
        "G2 X10 Y-10 I0 J-10 Z-1",
        "G90"
      ]
    },
    "bootBanner": [
      "PCB v1.1 Detected",
      "Grbl v1.00",
      "ready",
      "ok",
      "[Forward Calculating Position]",
      "position loaded at:",
      "247.79",
      "-5.88"
    ]
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "G21"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X10 Y10  \n"},
    {"type": "rx", "line": "G0 X10 Y10"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G91 \n"},
    {"type": "rx", "line": "G91"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"uploadFlag": 2, "gcodeIndex": 3}, "alerts": [{"title": "Line Unsupported Arc", "message": "Line 4 is a relative (G91) arc with a Z move; the controller takes an arc's Z as absolute."}]}
  ]
}
