  "meta": {
    "name": "connect_eeprom_read_fail_restores_settings",
    "description": "A boot that reports `error: EEPROM read fail` (every firmware upgrade or downgrade): after the boot's $$ every setting is written, the keys WebControl never knew from their defaults, and the user is told. The factory $38 differs, so once the push is answered WebControl closes and reopens the port, which resets the board (B2); the next boot's $$ shows every value held and only $13 goes out.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "877ba83"
  },
