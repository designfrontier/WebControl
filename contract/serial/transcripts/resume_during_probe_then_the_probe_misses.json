{
  "formatVersion": 1,
  "meta": {
    "name": "resume_during_probe_then_the_probe_misses",
    "description": "Resume pressed while a touchZ probe descends during a paused job, and the probe then misses: the ~'s ok is not taken as a touch, the probe's `error: probe did not connect` is its answer, so no G10 Z0 goes out and the user is told.",
    "firmware": {
      "variant": "holey",
      "version": "51.27"
    },
    "webcontrolCommit": "26d1a6c"
  },
  "setup": {
    "units": "MM",
    "home": {
      "x": 0,
      "y": 0
    },
    "gcode": {
      "path": "gcode/square_mm.nc"
    }
  },
  "events": [
    {"type": "ui", "action": {"command": "startRun", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X10.5 Y10.25  \n"},
    {"type": "ui", "action": {"command": "pauseRun", "arg": "", "arg1": ""}},
    {"type": "rx", "line": "ok"},
    {"type": "ui", "action": {"command": "touchZ", "arg": "", "arg1": ""}},
    {"type": "tx", "bytes": "G90 G38.2 Z-10 \n"},
    {"type": "rx", "line": "probing for z axis zero"},
    {"type": "rx", "line": "max depth -10.00 mm."},
    {"type": "rx", "line": "feedrate 39.94 mm per min."},
    {"type": "ui", "action": {"command": "resumeRun", "arg": "", "arg1": ""}, "comment": "the probe is still descending"},
    {"type": "tx", "bytes": "~\n", "realtime": true},
    {"type": "rx", "line": "ok", "comment": "the ~'s own ack, which is not the probe's answer"},
    {"type": "expect", "state": {"uploadFlag": 1}, "noAlerts": [{"title": "Touch Z"}]},
    {"type": "rx", "line": "error: probe did not connect"},
    {"type": "tx", "bytes": "G21  \n"},
    {"type": "rx", "line": "program stopped"},
    {"type": "rx", "line": "z axis not set"},
    {"type": "rx", "line": ""},
    {"type": "expect", "alerts": [{"title": "Touch Z Failed", "message": "Z was not zeroed"}]},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5.0  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 X10.5 Y10.25  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z5.0 F12.8  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G90  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Z-1.5 F127  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X30.5 F600  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Y30.25  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 X10.5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G1 Y10.25  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "G0 Z5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "tx", "bytes": "M5  \n"},
    {"type": "rx", "line": "ok"},
    {"type": "expect", "state": {"uploadFlag": 0, "jobInProgress": false, "gcodeIndex": 0}}
